#   - auto mode / model switching can move us off the single deployment we actually serve.
export CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1  # non-streaming fallback can re-execute tools
export CLAUDE_CODE_ATTRIBUTION_HEADER=0             # keeps vLLM prefix caching effective
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1
# NOTE: we deliberately do NOT unset proxy variables. Clearing http_proxy/https_proxy
# propagates to every child process — git, gh, npm, and our own search MCP server — so a
# customer whose only route to the internet is a corporate proxy would find the endpoint
# unreachable with nothing to explain why.

command -v claude >/dev/null 2>&1 || { echo "FATAL: 'claude' not found on PATH"; exit 127; }

CC_ARGS=(--settings "$SETTINGS")
if (( SEARCH_ENABLED )); then
    CC_ARGS+=(--mcp-config "$MCPCFG")
    # We inject our search server, but we do NOT exclude the customer's own MCP servers by
    # default: --strict-mcp-config makes Claude Code refuse to start at all when an enterprise
    # managed-mcp.json is present, and silently drops plugin-provided servers, which presents
    # to the model as "that tool does not exist". Opt in with TEE_CLAUDE_STRICT_MCP=1.
    [[ "${TEE_CLAUDE_STRICT_MCP:-}" == "1" ]] && CC_ARGS+=(--strict-mcp-config)
fi
# --append-system-prompt is last-wins in Claude Code, so if the caller passes their own we
# must not clobber it.
if [[ " $* " != *" --append-system-prompt "* ]]; then
    CC_ARGS+=(--append-system-prompt "$SEARCH_PROMPT")
else
    echo "note: caller supplied --append-system-prompt; skipping our tool-usage hint." >&2
fi
exec claude "${CC_ARGS[@]}" "$@"
