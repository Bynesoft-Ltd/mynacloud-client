    fi
    [[ "$SIG_URL" == "-" ]] && die "release $TAG carries no SHA256SUMS.sig, and this build requires one. Refusing."
    curl -fsSL --proto '=https' --tlsv1.2 -m 30 "$SIG_URL" -o "$tmp/SHA256SUMS.sig" || die "signature download failed"
