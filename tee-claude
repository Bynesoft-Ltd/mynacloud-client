            return ""
        return str(n) if 0 < n <= 100000000 else ""
    print("\t".join([name,
                     clean(mi.get("display_name") or name, 120),
                     clean(mi.get("description") or "", 300),
                     num(mi.get("max_input_tokens")),
                     num(mi.get("max_tokens"))]))
    break
PY

