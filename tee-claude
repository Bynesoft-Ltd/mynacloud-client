    [[ "$ans" == "yes" ]] || { echo "Aborted. Nothing was written."; exit 1; }
    for f in tee-claude websearch-mcp.py no-attachment-hook.py policy.example.json install.sh README.md; do
        [[ -f "$newroot/$f" ]] || continue
        # write-to-temp-then-rename, so an interrupted update never leaves a half file
        cp "$newroot/$f" "$CLIENT_DIR/.$f.new" && mv -f "$CLIENT_DIR/.$f.new" "$CLIENT_DIR/$f"
    done
    chmod 755 "$CLIENT_DIR/tee-claude" "$CLIENT_DIR/websearch-mcp.py" \
              "$CLIENT_DIR/no-attachment-hook.py" 2>/dev/null || true
    echo "Updated to $TAG."
    exit 0
fi

# =============================================================================
# 0. local policy
# =============================================================================
echo
echo "tee-claude $VERSION — endpoint verification"
echo

need python3

if [[ ! -f "$POLICY" ]]; then
    echo "  FATAL: no local policy at $(san "$POLICY")"
    echo "  Copy policy.example.json -> $CONFIG_DIR/policy.json and edit it."
    echo
    echo "  The policy is YOUR file. It pins the endpoint hostname, the TLS"
    echo "  certificate, and the model you approved. Only the endpoint's TCP"
    echo "  PORT is discovered at run time (it changes on every restart); the"
    echo "  hostname and the certificate pins are never taken from the network."
    exit 2
fi

# ---- pget: read one dotted key out of the policy ---------------------------
# The policy PATH and the KEY both cross into Python as argv. Interpolating
# either one into the program text was a remote-code-execution bug reachable
# through TEE_CLAUDE_POLICY before any consent gate. [audit A25]
pget() {
    python3 - "$POLICY" "$1" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print(""); sys.exit(0)
v = d
for k in sys.argv[2].split("."):
    v = (v or {}).get(k) if isinstance(v, dict) else None
if v is None or isinstance(v, (dict, list)):
    print("")
else:
    print(v)
PY
}

SCHEME="$(pget endpoint_scheme)";     SCHEME="${SCHEME:-https}"
HOST="$(pget endpoint_host)"
STATIC_PORT="$(pget endpoint_port)"
TXT_RECORD="$(pget port_discovery.record)"
TXT_KEY="$(pget port_discovery.key)";  TXT_KEY="${TXT_KEY:-port}"
EXP_MODEL="$(pget model)"
PIN_SPKI="$(pget tls_spki_sha256)"
ISSUER_ORG="$(pget expected_issuer_org)"
ISSUER_CN_RE="$(pget expected_issuer_cn_regex)"
MIN_TLS="$(pget min_tls_version)";     MIN_TLS="${MIN_TLS:-TLSv1.2}"
LEGACY_ENDPOINT="$(pget endpoint)"

# A v1 policy pinned a whole URL. Still honoured (the operator's loopback debug
# policies use it), but it opts out of port discovery, which is stated as such.
if [[ -z "$HOST" && -n "$LEGACY_ENDPOINT" ]]; then
    _rest="${LEGACY_ENDPOINT#*://}"
    SCHEME="${LEGACY_ENDPOINT%%://*}"
    _hostport="${_rest%%/*}"
    HOST="${_hostport%%:*}"
    [[ "$_hostport" == *:* ]] && STATIC_PORT="${_hostport##*:}"
fi

ver 1 "Local policy parsed: $(basename "$POLICY")"
if [[ -n "$HOST" && -n "$EXP_MODEL" ]]; then
    ver 2 "Policy pins endpoint host + model ($HOST / $EXP_MODEL)"
else
    fail 2 "Policy must pin both an endpoint host and a model"
fi

# Releases ARE signed now, and `--update` refuses anything that does not verify
# against the pinned publisher key. This still reports UNSUPPORTED, and that is
# not an oversight: a running program checking its own signature proves nothing,
# because code that has already been altered can print whatever it likes. The
# signature is meaningful at the moment of *installation*, which is a different
# event from this one. Claiming otherwise here would be the exact species of
# false assurance the rest of this listing exists to avoid.
unsup 3 "Launcher self-integrity — releases are signed (Ed25519) and --update enforces it, but a running program cannot attest to its own file"
if git -C "$CLIENT_DIR" rev-parse --short HEAD >/dev/null 2>&1; then
    info 4 "Launcher source revision: $(git -C "$CLIENT_DIR" rev-parse --short HEAD)"
else
    info 4 "Launcher source revision: not a git checkout (installed release $VERSION)"
fi
unsup 5 "Independent reproducible-build quorum (not established)"

# =============================================================================
# 1. endpoint discovery — the PORT, and only the port, comes from DNS
# =============================================================================
# The pod's public IP and its TCP port both change on every restart, and it is
# restarted every night. The A record is updated at boot; the current port is
# published as a TXT record.
#
# THE HOSTNAME IS NEVER DISCOVERED. It is pinned in this local policy, and every
# TLS check below runs against the pinned name. The blast radius of someone who
# can forge or tamper with the TXT record is therefore exactly "move us to a
# different port on a host we still fully verify" — they cannot redirect the
# session to a host of their choosing, because a certificate for that host would
# not validate against the pinned name (check [08]), would not match the pinned
# SPKI (check [10]) and would not carry the pinned leaf identity (check [11]).
LOOPBACK=0
[[ "$HOST" == "127.0.0.1" || "$HOST" == "localhost" || "$HOST" == "::1" ]] && LOOPBACK=1

PORT=""
if [[ -n "${TEE_CLAUDE_PORT:-}" ]]; then
    if [[ "$TEE_CLAUDE_PORT" =~ ^[0-9]{1,5}$ ]] && (( TEE_CLAUDE_PORT >= 1 && TEE_CLAUDE_PORT <= 65535 )); then
        PORT="$TEE_CLAUDE_PORT"
        info 6 "Endpoint port taken from TEE_CLAUDE_PORT=$PORT (DNS discovery skipped; host still pinned)"
    else
        fail 6 "TEE_CLAUDE_PORT is not a valid port number"
    fi
elif [[ -n "$STATIC_PORT" ]]; then
    if [[ "$STATIC_PORT" =~ ^[0-9]{1,5}$ ]] && (( STATIC_PORT >= 1 && STATIC_PORT <= 65535 )); then
        PORT="$STATIC_PORT"
        info 6 "Endpoint port pinned statically in the policy ($PORT); DNS discovery not used"
    else
        fail 6 "Policy 'endpoint_port' is not a valid port number"
    fi
elif [[ -z "$TXT_RECORD" ]]; then
    fail 6 "Policy has neither 'endpoint_port' nor 'port_discovery.record' — cannot locate the endpoint"
elif [[ "$TXT_RECORD" != "$HOST" && "$TXT_RECORD" != *".$HOST" ]]; then
    # Encoded invariant: discovery must live under the pinned name, so a policy
    # typo can never point discovery at a domain the operator does not control.
    fail 6 "port_discovery.record ($TXT_RECORD) is not under the pinned host ($HOST)"
else
    dns_txt() {
        local out=""
        if command -v dig >/dev/null 2>&1; then
            out="$(dig +short +timeout=5 +tries=2 TXT "$1" 2>/dev/null)"
        fi
        if [[ -z "$out" ]] && command -v host >/dev/null 2>&1; then
            out="$(host -W 5 -t TXT "$1" 2>/dev/null | sed -n 's/.*descriptive text //p')"
        fi
        if [[ -z "$out" ]] && command -v nslookup >/dev/null 2>&1; then
            out="$(nslookup -type=TXT "$1" 2>/dev/null | sed -n 's/.*text = //p')"
        fi
        printf '%s\n' "$out"
    }
    if ! command -v dig >/dev/null 2>&1 && ! command -v host >/dev/null 2>&1 \
         && ! command -v nslookup >/dev/null 2>&1; then
        fail 6 "No DNS TXT resolver found (install dig/host/nslookup, or set TEE_CLAUDE_PORT)"
    else
        _txt="$(dns_txt "$TXT_RECORD")"
        PORT="$(printf '%s' "$_txt" | python3 -c "$PY_TXT_PORT" "$TXT_KEY")"
        if [[ -z "$_txt" ]]; then
            fail 6 "DNS TXT $TXT_RECORD did not resolve — cannot locate the endpoint (see 'Nightly outage' below)"
        elif [[ -z "$PORT" ]]; then
            fail 6 "DNS TXT $TXT_RECORD is missing or ambiguous for '$TXT_KEY=' — refusing to guess"
        else
            ver 6 "Endpoint port discovered from DNS TXT $TXT_RECORD ($TXT_KEY=$PORT)"
        fi
    fi
fi

ENDPOINT=""
[[ -n "$HOST" && -n "$PORT" ]] && ENDPOINT="$SCHEME://$HOST:$PORT"

if [[ -z "$HOST" ]]; then
    fail 7 "No endpoint host to resolve"
elif [[ $LOOPBACK -eq 1 ]] || getent hosts "$HOST" >/dev/null 2>&1 \
     || python3 -c 'import socket,sys; socket.getaddrinfo(sys.argv[1],None)' "$HOST" >/dev/null 2>&1; then
    ver 7 "Endpoint host resolves: $HOST"
else
    fail 7 "Endpoint host does not resolve: $HOST"
fi

# =============================================================================
# 2. transport
# =============================================================================
LEAF_PEM=""
if [[ "$SCHEME" == "https" && -n "$PORT" && -n "$HOST" ]]; then
    # -verify_hostname is the whole point of check [08]. The previous version
    # printed "chain verified; hostname matches" on the mere presence of a
    # BEGIN CERTIFICATE line, which any self-signed certificate satisfies.
    # [audit A26]
    if [[ "$OPENSSL_HAS_VHOST" -ne 1 ]]; then
        fail 8  "No openssl here can verify hostnames: ${OPENSSL:-none found} lacks -verify_hostname. Fix: brew install openssl@3"
        fail 9  "TLS version/cipher not established"
        fail 10 "TLS SPKI not obtained"
        fail 11 "Certificate identity not established"
        fail 12 "Certificate validity not established"
    else
    # stdin is /dev/null so s_client sees EOF and closes after the handshake.
    # It is stated explicitly rather than piped in, because a backgrounded
    # command (the run_bounded fallback path) gets /dev/null for stdin anyway —
    # this way all three implementations behave identically.
    tls_out="$(run_bounded 20 "$OPENSSL" s_client -connect "$HOST:$PORT" -servername "$HOST" \
                 -verify_hostname "$HOST" -verify_return_error -verify 6 </dev/null 2>&1)"
    tls_rc=$?
    LEAF_PEM="$(sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' <<<"$tls_out" \
                | sed '/-----END CERTIFICATE-----/q')"
    if [[ -n "$LEAF_PEM" ]] && grep -q 'Verify return code: 0 (ok)' <<<"$tls_out"; then
        ver 8 "TLS handshake OK; chain verified to a system root; hostname matches $HOST"

        tlsver="$(grep -m1 -oE 'TLSv1\.[0-9]' <<<"$tls_out" | head -1)"
        # The `Cipher   :` line lives in the SSL-Session block, which OpenSSL 3.x
        # does NOT print for a TLS 1.3 session that closes before the server's
        # session ticket arrives — which is every run here, since stdin is EOF.
        # Without the fallback this reports `cipher ` with an empty value, i.e.
        # a blank field in a security attestation. Fall back to the summary line
        # ("New, TLSv1.3, Cipher is TLS_AES_256_GCM_SHA384"), and say so plainly
        # if neither is present rather than printing nothing.
        cipher="$(grep -m1 'Cipher *:' <<<"$tls_out" | awk '{print $NF}')"
        if [[ -z "$cipher" || "$cipher" == ":" ]]; then
            cipher="$(grep -m1 -E '^New, TLSv[0-9.]+, Cipher is ' <<<"$tls_out" | sed 's/.*Cipher is //')"
        fi
        [[ -z "$cipher" ]] && cipher="(not reported by openssl)"
        _rank() { case "$1" in TLSv1.3) echo 4;; TLSv1.2) echo 3;; TLSv1.1) echo 2;; TLSv1.0) echo 1;; *) echo 0;; esac; }
        if (( $(_rank "$tlsver") >= $(_rank "$MIN_TLS") )) && (( $(_rank "$tlsver") > 0 )); then
            ver 9 "TLS $tlsver, cipher $cipher (policy floor $MIN_TLS)"
        else
            fail 9 "TLS version below the policy floor $MIN_TLS (got ${tlsver:-unknown})"
        fi

        spki="$(printf '%s\n' "$LEAF_PEM" | "$OPENSSL" x509 -noout -pubkey 2>/dev/null \
                | "$OPENSSL" pkey -pubin -outform der 2>/dev/null \
                | "$OPENSSL" dgst -sha256 -hex 2>/dev/null | awk '{print $NF}')"
        if [[ -z "$PIN_SPKI" || "$PIN_SPKI" == "REPLACE-ME" ]]; then
            # Unpinned used to be INFORMATIONAL. It is a FAILED: the product's
            # pitch is verification, and an unpinned key means the only thing
            # standing between you and any CA-issued certificate for this name
            # is the public CA system. Get the published pin, or run
            # `tee-claude --print-spki` and pin what you see after checking it
            # against the value the operator publishes.
            fail 10 "TLS SPKI is not pinned in your policy (tls_spki_sha256 is empty or REPLACE-ME) — see --print-spki"
        elif [[ "$spki" == "$PIN_SPKI" ]]; then
            ver 10 "TLS SPKI matches the policy pin"
        else
            fail 10 "TLS SPKI does NOT match the policy pin (expected ${PIN_SPKI:0:16}..., got ${spki:0:16}...)"
        fi

        # ---- [11] this certificate is OURS, not merely a valid one ----------
        # WHY THIS EXISTS, in one specific scenario: the A record for this host
        # is on Cloudflare. Today it is DNS-only ("grey cloud") and the TLS
        # session terminates on our own pod. If that record is ever flipped to
        # proxied ("orange cloud") — by an operator mistake, or by anyone who
        # gets into the Cloudflare account — Cloudflare terminates TLS itself
        # and presents ITS certificate. The chain would still verify, the
        # hostname would still match, and check [08] would still pass, while
        # every prompt and every response was readable in plaintext by a third
        # party we never disclosed. That failure is invisible to a generic TLS
        # check and must be loud, so we assert the issuer and the leaf identity
        # we actually expect. (The SPKI pin at [10] catches the same thing; this
        # check survives our own certificate renewals, which the SPKI pin does
        # not, so we want both.)
        if [[ -z "$ISSUER_ORG" && -z "$ISSUER_CN_RE" ]]; then
            fail 11 "Policy pins no expected certificate issuer (expected_issuer_org) — refusing to skip the check"
        else
            _idres="$(printf '%s\n' "$LEAF_PEM" \
                | "$OPENSSL" x509 -noout -issuer -subject -ext subjectAltName -nameopt RFC2253 2>/dev/null \
                | ISSUER_ORG="$ISSUER_ORG" ISSUER_CN_RE="$ISSUER_CN_RE" python3 -c "$PY_CERT_ID" "$HOST")"
            if [[ "$_idres" == OK* ]]; then
                ver 11 "Certificate is ours: ${_idres#OK }"
            else
                fail 11 "Certificate is NOT the expected one: ${_idres#FAIL }  (if this host was just put behind a TLS-terminating proxy, STOP)"
            fi
        fi

        if printf '%s\n' "$LEAF_PEM" | "$OPENSSL" x509 -noout -checkend 0 >/dev/null 2>&1; then
            ver 12 "Certificate within its validity window"
        else
            fail 12 "Certificate expired or not yet valid"
        fi
    else
        # Say which of the three it was. "Verification failed" is a claim about
        # the ENDPOINT; a timeout or a local openssl that never ran are claims
        # about THIS MACHINE, and conflating them is what made the macOS bug so
        # hard to read from the output alone.
        _why="$(grep -m1 -E 'Verification error|verify error|Verify return code' <<<"$tls_out" | head -1)"
        if [[ "$tls_rc" -eq 124 ]]; then
            fail 8  "TLS probe timed out after 20s against $HOST:$PORT — endpoint unreachable or not answering"
        elif [[ -z "$_why" && -z "$LEAF_PEM" ]]; then
            fail 8  "TLS probe produced no certificate and no verification result (local openssl failure, exit $tls_rc) — this is a problem with THIS machine, not the endpoint: $(printf '%s' "$tls_out" | head -1)"
        else
            fail 8  "TLS handshake, chain or hostname verification failed${_why:+ — $_why}"
        fi
        fail 9  "TLS version/cipher not established"
        fail 10 "TLS SPKI not obtained"
        fail 11 "Certificate identity not established"
        fail 12 "Certificate validity not established"
    fi
    fi
elif [[ $LOOPBACK -eq 1 ]]; then
    info 8  "Loopback endpoint — TLS not applicable (no network exposure)"
    info 9  "Loopback endpoint — TLS version/cipher not applicable"
    info 10 "Loopback endpoint — TLS SPKI not applicable"
    info 11 "Loopback endpoint — certificate identity not applicable"
    info 12 "Loopback endpoint — certificate validity not applicable"
elif [[ -z "$PORT" ]]; then
    fail 8  "No endpoint port — TLS not attempted"
    fail 9  "No TLS"; fail 10 "No TLS"; fail 11 "No TLS"; fail 12 "No TLS"
else
    fail 8  "Plaintext http:// to a NON-loopback host — refusing (prompts would transit in clear)"
    fail 9  "No TLS"; fail 10 "No TLS"; fail 11 "No TLS"; fail 12 "No TLS"
fi

# ---- --print-spki: an operator/customer helper, prints and exits -----------
if [[ "${1:-}" == "--print-spki" ]]; then
    echo
    if [[ -n "$LEAF_PEM" ]]; then
        echo "tls_spki_sha256 for $HOST:$PORT"
        printf '%s\n' "$LEAF_PEM" | "$OPENSSL" x509 -noout -pubkey \
            | "$OPENSSL" pkey -pubin -outform der | "$OPENSSL" dgst -sha256 -hex | awk '{print "  " $NF}'
        echo
        echo "Compare this against the value the operator publishes BEFORE you put it"
        echo "in your policy. Pinning whatever you happen to see is trust-on-first-use,"
        echo "which is strictly weaker."
    else
        echo "No certificate was obtained; nothing to print."
    fi
    exit 0
fi

# =============================================================================
# 3. credential — presence only. Nothing is sent yet. [audit A29]
# =============================================================================
TOKEN="${ANTHROPIC_AUTH_TOKEN:-}"
if [[ -z "$TOKEN" && -f "$CONFIG_DIR/token" ]]; then
    _mode="$(stat -c '%a' "$CONFIG_DIR/token" 2>/dev/null || stat -f '%Lp' "$CONFIG_DIR/token" 2>/dev/null || echo "")"
    if [[ -n "$_mode" && "${_mode: -2}" != "00" ]]; then
        echo "  warning: $CONFIG_DIR/token is mode $_mode — run: chmod 600 $CONFIG_DIR/token" >&2
    fi
    TOKEN="$(tr -d '[:space:]' < "$CONFIG_DIR/token")"
fi
# Nothing found yet, and someone is sitting at a terminal: ASK. The instruction this
# replaces was
#
#     umask 077 && printf '%s' 'YOUR-KEY-HERE' > ~/.tee-claude/token
#
# which is worse than a prompt for a reason that is easy to miss: `printf ... 'KEY'`
# goes into the shell's history file. On a default bash or zsh the credential ends up in
# ~/.bash_history or ~/.zsh_history in cleartext, surviving the session, and nothing in
# that one-liner hints at it. A read with echo off never touches history at all.
#
# Read from /dev/tty, not stdin: stdin may be a pipe (`tee-claude -p ... < file`) and a
# credential must never be consumed from the same stream as data.
if [[ -z "$TOKEN" ]] && [[ -r /dev/tty ]] && [[ -t 1 ]]; then
    printf '  No credential found in $ANTHROPIC_AUTH_TOKEN or %s.\n' "$CONFIG_DIR/token"
    printf '  Paste your session key (not shown as you type), or press Enter to abort: '
    IFS= read -rs TOKEN < /dev/tty || TOKEN=""
    printf '\n'
    TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]')"
    if [[ -n "$TOKEN" && "$TOKEN" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
        # Offer to persist it, because otherwise this prompt is a worse UX than the file
        # it replaced: once per session forever. Default is NO — writing a credential to
        # disk is the user's call, not a default.
        printf '  Save it to %s so you are not asked again? [y/N] ' "$CONFIG_DIR/token"
        IFS= read -r _save < /dev/tty || _save=n
        if [[ "$_save" =~ ^[Yy] ]]; then
            mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR" 2>/dev/null || true
            # Create it empty at 600 FIRST, then write. Redirecting straight into a new
            # file would briefly leave it at the umask's mode with the key already in it.
            : > "$CONFIG_DIR/token"; chmod 600 "$CONFIG_DIR/token" 2>/dev/null || true
            printf '%s' "$TOKEN" > "$CONFIG_DIR/token"
            printf '  saved (mode 600). Delete that file to be asked again.\n'
        fi
        TOKEN_SOURCE="entered at the prompt"
    elif [[ -n "$TOKEN" ]]; then
        : # falls through to the alphabet check below, which refuses it
    fi
fi

if [[ -z "$TOKEN" ]]; then
    if [[ -r /dev/tty ]] && [[ -t 1 ]]; then
        fail 13 "No credential given"
    else
        # Non-interactive: no tty to prompt on, so say what to do instead of prompting
        # into the void. This is the CI / `| tee-claude` path.
        fail 13 "No credential and no terminal to ask on — set ANTHROPIC_AUTH_TOKEN or write $CONFIG_DIR/token"
    fi
elif [[ ! "$TOKEN" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
    # The credential is handed to curl through a config file on stdin, whose
    # quoting we must not be able to break out of. Real keys are in this
    # alphabet; anything else is a mistake or an attack, so refuse rather than
    # escape-and-hope.
    fail 13 "Credential contains characters outside the expected key alphabet — refusing to use it"
    TOKEN=""
else
    ver 13 "Session credential present (${#TOKEN} chars, ${TOKEN_SOURCE:-from environment or token file}; never printed, never on a command line)"
fi

# =============================================================================
# 4. TEE-rooted claims — unprovable without a Confidential VM + CC GPU
# =============================================================================
unsup 14 "Google Confidential VM attestation token"
unsup 15 "GCP project / instance / zone identity"
unsup 16 "Confidential Computing technology + Secure Boot state"
unsup 17 "NVIDIA GPU detached-EAT signature"
unsup 18 "NVIDIA device identity, CC mode, debug state"
unsup 19 "NVIDIA RIM / certificate chain / revocation"
unsup 20 "TPM quote signature and freshness"
unsup 21 "PCR replay against measured-boot log"
unsup 22 "IMA measurement-log replay"
unsup 23 "Running OCI image digest == customer-approved digest"
unsup 24 "OCI signature + transparency-log inclusion"
unsup 25 "Image-to-published-source revision binding"
unsup 26 "Measured LiteLLM configuration"
unsup 27 "Measured no-retention policy"
unsup 28 "Measured mount / writable-storage policy"
unsup 29 "Measured swap / core-dump / persistent-journal policy"
unsup 30 "Measured data-plane egress isolation"
unsup 31 "Model manifest digest approved from measured state"
unsup 32 "TLS key bound to attested environment"
unsup 33 "Session-token proof-of-possession binding"
unsup 34 "Deployment-policy approval from measured state"

# =============================================================================
# 5. client-side web search — configuration only, no network, no credential
# =============================================================================
SEARCH_MCP="$CLIENT_DIR/websearch-mcp.py"
MCPCFG="$CONFIG_DIR/mcp.json"
SEARCH_TOOL="mcp__websearch__web_search"
SEARCH_ENABLED=0
SEARCH_DISCLOSE="none — web search is disabled"

if [[ "${TEE_CLAUDE_SEARCH:-on}" == "off" ]]; then
    info 35 "Client-side web search: disabled by TEE_CLAUDE_SEARCH=off"
elif [[ ! -f "$SEARCH_MCP" ]]; then
    info 35 "Client-side web search: unavailable (websearch-mcp.py not found next to the launcher)"
else
    # search.env used to be `.`-sourced, which is arbitrary shell execution out
    # of a file this script does not own and never checks. It is now parsed, not
    # executed: only KEY=VALUE lines, only from a known set of keys, and only
    # from a file owned by you and not writable by anyone else. [audit, 2026-07-25]
    SEARCH_ENV="$CONFIG_DIR/search.env"
    if [[ -f "$SEARCH_ENV" ]]; then
        _uid="$(id -u)"
        _owner="$(stat -c '%u' "$SEARCH_ENV" 2>/dev/null || stat -f '%u' "$SEARCH_ENV" 2>/dev/null || echo -1)"
        _mode="$(stat -c '%a' "$SEARCH_ENV" 2>/dev/null || stat -f '%Lp' "$SEARCH_ENV" 2>/dev/null || echo 777)"
        _mode="$(printf '%03d' "$((10#${_mode: -3}))" 2>/dev/null || echo 777)"
        if [[ "$_owner" != "$_uid" && "$_owner" != "0" ]]; then
            echo "  note: ignoring $SEARCH_ENV — it is owned by uid $_owner, not by you" >&2
        elif (( (10#${_mode:1:1} & 2) || (10#${_mode:2:1} & 2) )); then
            echo "  note: ignoring $SEARCH_ENV — mode $_mode is group/world-writable. Run: chmod 600 $SEARCH_ENV" >&2
        else
            while IFS= read -r _line; do
                case "$_line" in
                    WEBSEARCH_PROVIDER=*|WEBSEARCH_TIMEOUT=*|BRAVE_API_KEY=*|TAVILY_API_KEY=*|SEARXNG_URL=*)
                        _k="${_line%%=*}"; _v="${_line#*=}"
                        _v="${_v%\"}"; _v="${_v#\"}"; _v="${_v%\'}"; _v="${_v#\'}"
                        export "$_k=$_v" ;;
                esac
            done < <(LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' < "$SEARCH_ENV")
        fi
    fi
    SEARCH_CHAIN="$(python3 "$SEARCH_MCP" --selftest 2>/dev/null | sed -n 's/^provider chain *: //p')"
    SEARCH_CHAIN="$(san "${SEARCH_CHAIN:-unknown}")"
    SEARCH_ENABLED=1
    SEARCH_DISCLOSE="$SEARCH_CHAIN (tried in that order), plus any site fetched with WebFetch"
    ver 35 "Client-side web search available (local process; providers: $SEARCH_CHAIN)"
    [[ "$SEARCH_CHAIN" == *ddgs* ]] || \
        info 36 "Search quality: 'pip install ddgs' gives multi-engine keyless search, or set BRAVE_API_KEY / TAVILY_API_KEY / SEARXNG_URL in $CONFIG_DIR/search.env"
fi

