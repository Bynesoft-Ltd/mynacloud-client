SETTINGS="$CONFIG_DIR/settings.json"

# --- Client-side web search -------------------------------------------------
# The built-in WebSearch stays DENIED, and that is not a compromise — it is the
# only correct setting. WebSearch is not a client-side tool: it executes by
# issuing a nested /v1/messages call carrying Anthropic's server-side
# `web_search_20250305` tool and then reading `server_tool_use` /
# `web_search_tool_result` blocks out of the reply. Our backend never emits
# those, so the nested call collapses into "answer from memory" and Claude Code
# renders the model's recollection as if it were a search hit. Denying it
# converts a silent fabrication into a loud "not enabled here".
#
# In its place we register an MCP stdio server. Claude Code spawns stdio MCP
# servers as ordinary local child processes, so the HTTP request to the search
# provider originates on THIS machine, with the user's own IP and the user's own
# (optional) provider credential. The provider credential is referenced as
# ${VAR}, which Claude Code expands from its OWN process environment when it
# loads this file — so the key never lands in mcp.json, and never in a log.
#
# Both JSON files below are emitted by a JSON encoder from argv, not by a shell
# heredoc: a home directory containing a quote or a backslash used to produce
# either invalid JSON or an injected settings key. [same class as audit A25]
if (( SEARCH_ENABLED )); then
    python3 - "$MCPCFG" "$SEARCH_MCP" <<'PY'
import json, sys
cfg = {"mcpServers": {"websearch": {
    "type": "stdio",
    "command": "python3",
    "args": [sys.argv[2]],
    "env": {
        "WEBSEARCH_PROVIDER": "${WEBSEARCH_PROVIDER:-auto}",
        "WEBSEARCH_TIMEOUT": "${WEBSEARCH_TIMEOUT:-25}",
        "BRAVE_API_KEY": "${BRAVE_API_KEY:-}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY:-}",
        "SEARXNG_URL": "${SEARXNG_URL:-}",
    },
}}}
json.dump(cfg, open(sys.argv[1], "w"), indent=2)
PY
    chmod 600 "$MCPCFG" 2>/dev/null || true
fi

# The MCP tool name is structural (mcp__<server>__<tool>) and the built-in name is
# not repointable, so the model has to be told the replacement exists. Static text,
# which keeps the vLLM prefix cache warm.
if (( SEARCH_ENABLED )); then
    SEARCH_PROMPT="Web search in this session is provided by the ${SEARCH_TOOL} tool, \
which runs locally on the user's machine. The built-in WebSearch tool is disabled and \
will fail if you call it — use ${SEARCH_TOOL} instead whenever you need current \
information from the internet, then use WebFetch to read any returned URL in full. "
else
    SEARCH_PROMPT="Web search is disabled in this session. The built-in WebSearch tool \
will fail if you call it. Say that you cannot search the web rather than answering from \
memory as though you had. "
fi
SEARCH_PROMPT+="This deployment has no vision and cannot read PDFs. Never describe the \
contents of an image or a PDF. If the user refers to a screenshot, a diagram or a PDF, \
say plainly that you cannot see it and ask for the content as text — do not guess."

# --- Attachment interception -------------------------------------------------
# The hook is registered against every tool that can put file BYTES in front of
# the model, not just Read:
#   Read / NotebookRead   the obvious path
#   Bash                  `cat`/`head`/`base64` reach the same bytes
#   mcp__.*               filesystem MCP servers have their own read tools
# and as a UserPromptSubmit hook for `@`-mentions, which expand into content
# without ever becoming a tool call.
#
# What this CANNOT cover, stated plainly rather than papered over: an image
# pasted or dragged directly into the prompt box. Claude Code turns it into an
# image content block at submit time; it is not a tool call and it is not part
# of the prompt text a UserPromptSubmit hook receives, so there is no client-side
# interception point at all. That gap is disclosed in the consent text above and
# in the README. [audit A33]
python3 - "$SETTINGS" "$CLIENT_DIR/no-attachment-hook.py" "$SEARCH_TOOL" "$SEARCH_ENABLED" <<'PY'
import json, sys
settings_path, hook, search_tool, search_on = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1"
# The hook command is a string a shell will run, so single-quote the path and
# POSIX-escape any embedded quote. A home directory containing a quote used to
# produce invalid JSON here, or worse.
hook_cmd = "python3 '%s'" % hook.replace("'", "'\\''")
s = {
    "skipWebFetchPreflight": True,
    "includeCoAuthoredBy": False,
    "disableAutoMode": "disable",
    "hooks": {
        "PreToolUse": [{
            "matcher": "Read|NotebookRead|Bash|mcp__.*",
            "hooks": [{"type": "command", "command": hook_cmd}],
        }],
        "UserPromptSubmit": [{
            "hooks": [{"type": "command", "command": hook_cmd + " --prompt"}],
        }],
    },
    "switchModelsOnFlag": False,
    "permissions": {"deny": ["WebSearch"]},
}
if search_on:
    s["permissions"]["allow"] = [search_tool]
with open(settings_path, "w", encoding="utf-8") as f:
    json.dump(s, f, indent=2)
    f.write("\n")
PY
chmod 600 "$SETTINGS" 2>/dev/null || true

export ANTHROPIC_BASE_URL="$ENDPOINT"
export ANTHROPIC_AUTH_TOKEN="$TOKEN"
unset ANTHROPIC_API_KEY                             # both headers at once can 401 the gateway
export ANTHROPIC_MODEL="$MODEL_ID"
