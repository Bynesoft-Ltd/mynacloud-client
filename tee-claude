    echo "         $got"

    # WHAT THE CHECKSUM ABOVE IS AND IS NOT WORTH.
    #
    # It was fetched over TLS from a hardcoded repository path, so it is a
    # GitHub-authenticated assertion that this tarball is that release's asset.
    # That defeats a network attacker, a poisoned CDN edge and a truncated
    # download. It does NOT survive compromise of the publishing account: a
    # stolen token can replace the tarball and the SHA256SUMS beside it in the
    # same act, because both live in the same place under the same credential.
    #
    # The signature below is what closes that gap, and only that gap. Its key
    # is held offline, so repository write access is not enough to forge it.
    if [[ -z "$UPDATE_PUBKEY_PEM" ]]; then
        die "this build pins no publisher key, so it cannot verify who produced
  release $TAG. That is a defect in this build, not a problem with the release.
  Reinstall from https://github.com/$UPDATE_REPO to get a build that can."
    fi

    # --- signature: required, no override ------------------------------------
    if [[ "$OPENSSL_HAS_RAWIN" -ne 1 ]]; then
        die "cannot verify the release signature: ${OPENSSL:-no openssl found} lacks
