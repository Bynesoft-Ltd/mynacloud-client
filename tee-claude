# Every string below is attacker-controlled if the endpoint is hostile or has
# been compromised, and all of them are printed to a terminal and exported into
# a child process's environment. C0/C1 controls, DEL, bidi overrides and the
# unicode line separators are removed where they enter. [audit A27]
CTRL_RE = re.compile(
    "[\x00-\x1f\x7f-\x9f"          # C0, DEL, C1 (ESC and CR live here)
    "\u00ad\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u2069"
    "\u2028\u2029\ufeff]"           # soft hyphen, bidi overrides, separators
)
def clean(x, cap=160):
    return CTRL_RE.sub("", str(x if x is not None else ""))[:cap]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
rows = d.get("data") or d.get("model_list") or []
