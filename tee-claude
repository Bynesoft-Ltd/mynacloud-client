#!/usr/bin/env bash
# =============================================================================
# tee-claude — verifying launcher for Claude Code against the mynacloud endpoint
#
# Runs the endpoint verification sequence, prints every check individually with
# an honest verdict, shows the alpha-period disclosure, requires explicit typed
# consent, then execs `claude` with the bridge environment applied.
#
# VERDICTS (UNSUPPORTED is NOT equivalent to VERIFIED):
#   VERIFIED       proven by cryptographic evidence or direct measurement here
#   FAILED         actively wrong -> launch is REFUSED, always, no override
#   UNSUPPORTED    cannot be proven on this host (no TEE) -> disclosed + consented
#   INFORMATIONAL  context only, not a security claim
#
# Design rules:
#   - No check is ever silently skipped, and NO flag or environment variable
#     turns FAILED into a pass. There is no non-interactive consent bypass.
#   - Nothing that carries your credential runs before you have consented.
#     Checks [37]+ are the post-consent block, and a FAILED there still
#     refuses to launch.
#   - No value that reaches a shell, a Python program or a JSON file is ever
#     produced by string interpolation. Everything crosses process boundaries
#     as argv, environment, or JSON encoded by a JSON encoder.
#   - Every string that came from the network is stripped of control
#     characters before it is printed, so a hostile endpoint cannot repaint
#     this terminal.
# =============================================================================
set -uo pipefail

VERSION="0.2.6-alpha"
UPDATE_REPO="Bynesoft-Ltd/mynacloud-client"

# Ed25519 public key used by `--update` to verify the release SHA256SUMS.
# Paste it EXACTLY as `openssl pkey -in release.key -pubout` prints it, BEGIN
# and END lines included, e.g.
#     UPDATE_PUBKEY_PEM='-----BEGIN PUBLIC KEY-----
#     MCowBQYDK2VwAyEA...=
#     -----END PUBLIC KEY-----'
#
# This is the publisher key for Bynesoft-Ltd/mynacloud-client. `--update`
# verifies SHA256SUMS against it and REFUSES to write anything if the signature
# is missing or bad. There is no flag that turns that off.
#
# Its private half is held offline and is not on the inference host, so write
# access to the GitHub repository is NOT sufficient to forge a release this
# launcher will install. That is the whole and only point of it.
#
# Fingerprint, so it can be checked against the value published in the release
# notes without trusting this file:
#     openssl pkey -pubin -in <(…) -pubout | sha256sum
#     c5e23c4331666ac33c8020e1c7d3c91c0674336a20eaa8f5740adcc2650dc65e
UPDATE_PUBKEY_PEM='-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEADLPJNdv6OJUzzWPKtgmIkuH1QdzFQIXBZVqsA8jdbIY=
-----END PUBLIC KEY-----'

# ---- locate ourselves, through symlinks (the installer symlinks into ~/.local/bin)
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _dir="$(cd -P "$(dirname "$_self")" >/dev/null 2>&1 && pwd)"
    _self="$(readlink "$_self")"
    [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SELF="$(cd -P "$(dirname "$_self")" >/dev/null 2>&1 && pwd)/$(basename "$_self")"
CLIENT_DIR="$(dirname "$SELF")"

CONFIG_DIR="${TEE_CLAUDE_CONFIG_DIR:-$HOME/.tee-claude}"

# Policy search order: explicit override, then the per-user config dir (where the
# installer puts it), then next to the launcher (git checkout / tarball layout).
if [[ -n "${TEE_CLAUDE_POLICY:-}" ]]; then
    POLICY="$TEE_CLAUDE_POLICY"
elif [[ -f "$CONFIG_DIR/policy.json" ]]; then
    POLICY="$CONFIG_DIR/policy.json"
else
    POLICY="$CLIENT_DIR/policy.json"
fi

VERIFY_ONLY=0
case "${1:-}" in
    --verify-only) VERIFY_ONLY=1; shift ;;
    --version)     echo "tee-claude $VERSION"; exit 0 ;;
    -h|--help)
        cat <<'USAGE'
tee-claude — verifying launcher for Claude Code against the mynacloud endpoint

  tee-claude [claude args...]   verify, disclose, ask for consent, launch Claude Code
  tee-claude --verify-only      run the pre-consent checks and stop
  tee-claude --print-spki       print the endpoint's current TLS SPKI pin and stop
  tee-claude --update           check for a newer signed release
  tee-claude --version
  tee-claude --help

Environment:
  TEE_CLAUDE_POLICY       path to the local trust policy (default ~/.tee-claude/policy.json)
  TEE_CLAUDE_CONFIG_DIR   per-user state directory (default ~/.tee-claude)
  TEE_CLAUDE_SEARCH=off   disable the client-side web-search MCP server
  TEE_CLAUDE_STRICT_MCP=1 load ONLY our MCP server, not the ones you have configured
  TEE_CLAUDE_PORT=NNNN    skip DNS port discovery and use this port (the hostname
                          stays pinned by your policy either way)
  ANTHROPIC_AUTH_TOKEN    your session credential. If unset and no ~/.tee-claude/token\n                          exists, you are asked for it at startup (never echoed,\n                          never in shell history)

There is deliberately no flag that converts a FAILED check into a pass.
USAGE
        exit 0 ;;
esac

# ---- verdict tallies -------------------------------------------------------
n_ver=0; n_fail=0; n_unsup=0; n_info=0
FAILED_DETAIL=()

# Every printed field goes through san(): a hostile endpoint (or a hostile
# filename) must not be able to emit ESC, CR or a newline into this listing and
# repaint an UNSUPPORTED line as VERIFIED. [audit A27]
# C0 and DEL are stripped here, portably. C1, bidi overrides and the unicode line
# separators are stripped by CTRL_RE inside every Python program that ingests a
# server-supplied string, i.e. at the point where such a string enters at all.
san() { printf '%s' "${1-}" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-300; }

c()  { printf '  [%02d] %-13s %s\n' "$1" "$2" "$(san "$3")"; }
ver()   { c "$1" VERIFIED      "$2"; n_ver=$((n_ver+1)); }
fail()  { c "$1" FAILED        "$2"; n_fail=$((n_fail+1)); FAILED_DETAIL+=("[$1] $(san "$2")"); }
unsup() { c "$1" UNSUPPORTED   "$2"; n_unsup=$((n_unsup+1)); }
info()  { c "$1" INFORMATIONAL "$2"; n_info=$((n_info+1)); }

die() { echo "  FATAL: $(san "$1")" >&2; exit "${2:-2}"; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"; }

# ---- bounded execution -----------------------------------------------------
# Run a command with a wall-clock bound, on any macOS or Linux host.
#
# WHY THIS IS NOT JUST `timeout`: GNU coreutils' timeout(1) gates the TLS probe
# at check [08]. It is NOT part of a stock macOS install, and `gtimeout` exists
# only for users who installed coreutils themselves. While [08] called `timeout`
# unconditionally, every stock-Mac run printed
#     [08] FAILED  TLS handshake, chain or hostname verification failed
# with no reason appended — because openssl had never run at all. A missing
# local tool was wearing the costume of a hostile endpoint.
#
# That is the worst available failure mode for this program. Its entire value is
# telling you apart from an attacker, and it was reporting "your endpoint's
# certificate cannot be trusted" when the truth was "coreutils is not
# installed". It also proves the mirror-image bug is possible: a check that
# cannot run must never be reportable as a check that passed. So the bound is
# implemented here rather than delegated to a tool that may not exist.
#
# Bash 3.2 only — that is still what /bin/bash is on macOS. No `wait -n`, no
# nameref, no ${var,,}.
run_bounded() {
    local _secs="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        command timeout "$_secs" "$@"; return $?
    fi
    if command -v gtimeout >/dev/null 2>&1; then
        command gtimeout "$_secs" "$@"; return $?
    fi

    # No coreutils. Run the command in the background and let a watchdog kill
    # it. The watchdog's stdout MUST be redirected: a command substitution
    # around this function does not return until every process holding the
    # write end of its pipe has closed it, so a watchdog that inherited stdout
    # would stall the caller for the FULL timeout even when the command
    # finished immediately. That bug is invisible on a fast link and looks like
    # a hang on a slow one, so it is closed here by construction.
    "$@" &
    local _pid=$!
    ( sleep "$_secs"; kill -TERM "$_pid" 2>/dev/null ) >/dev/null 2>&1 &
    local _watchdog=$!

    local _rc=0
    wait "$_pid" 2>/dev/null || _rc=$?

    # Stand the watchdog down. Its orphaned `sleep` exits on its own and holds
    # no descriptor the caller is waiting on.
    kill -TERM "$_watchdog" 2>/dev/null || true
    wait "$_watchdog" 2>/dev/null || true

    # 128+SIGTERM means the watchdog fired. Report 124 so a caller cannot tell
    # this implementation apart from coreutils.
    [ "$_rc" -eq 143 ] && _rc=124
    return "$_rc"
}

# ---- choosing an openssl that can actually do the job ----------------------
# macOS ships LibreSSL as /usr/bin/openssl. Measured on macOS, LibreSSL 3.3.6:
#
#     openssl s_client -help | grep -c -- -verify_hostname   ->  0
#     openssl pkeyutl  -help | grep -c -- -rawin             ->  0
#     openssl genpkey -algorithm ed25519                     ->  "not found"
#
# So the system openssl cannot verify a hostname, cannot verify an Ed25519
# release signature, and does not know the algorithm exists. `x509 -ext` is
# missing too, which check [11] needs. A Mac with Homebrew has a capable
# OpenSSL 3.x, but only if it happens to come first on PATH — and whether it
# does is an accident of shell configuration, not something a customer should
# have to reason about.
#
# So: find a capable binary rather than trusting the name `openssl`. Every call
# site below uses "$OPENSSL", never a bare `openssl`.
OPENSSL=""            # the binary chosen; "" if nothing usable was found
OPENSSL_HAS_VHOST=0   # s_client -verify_hostname : required for check [08]
OPENSSL_HAS_RAWIN=0   # pkeyutl -rawin            : required for --update

pick_openssl() {
    local cands=() c vh ri best_vh=""
    # An explicit override wins, so a user with a non-standard install is never
    # stuck arguing with this list.
    [[ -n "${TEE_CLAUDE_OPENSSL:-}" ]] && cands+=("$TEE_CLAUDE_OPENSSL")
    c="$(command -v openssl 2>/dev/null)"; [[ -n "$c" ]] && cands+=("$c")
    # Standard Homebrew (arm64 and Intel), MacPorts, then the system one last —
    # it is the least capable, but naming it in an error beats "not found".
    cands+=(/opt/homebrew/bin/openssl /opt/homebrew/opt/openssl@3/bin/openssl \
            /usr/local/bin/openssl   /usr/local/opt/openssl@3/bin/openssl \
            /opt/local/bin/openssl   /usr/bin/openssl)

    for c in "${cands[@]}"; do
        [[ -x "$c" ]] || continue
        vh=0; ri=0
        "$c" s_client -help 2>&1 | grep -q -- '-verify_hostname' && vh=1
        "$c" pkeyutl  -help 2>&1 | grep -q -- '-rawin'           && ri=1
        if [[ "$vh" -eq 1 && "$ri" -eq 1 ]]; then
            OPENSSL="$c"; OPENSSL_HAS_VHOST=1; OPENSSL_HAS_RAWIN=1; return 0
        fi
        # Remember a partially-capable one, but keep looking for a better.
        [[ "$vh" -eq 1 && -z "$best_vh" ]] && best_vh="$c"
    done

    if [[ -n "$best_vh" ]]; then
        OPENSSL="$best_vh"; OPENSSL_HAS_VHOST=1; OPENSSL_HAS_RAWIN=0; return 0
    fi
    for c in "${cands[@]}"; do [[ -x "$c" ]] && { OPENSSL="$c"; break; }; done
    return 1
}

OPENSSL_ADVICE="macOS ships LibreSSL as /usr/bin/openssl, which cannot do this.
  Install OpenSSL 3:   brew install openssl@3
  tee-claude then finds it automatically — you do NOT need to change your PATH.
  Or name one explicitly:  TEE_CLAUDE_OPENSSL=/path/to/openssl tee-claude"

pick_openssl || true

# ---- helper programs -------------------------------------------------------
# Held in variables and handed to `python3 -c` because these ones read their
# INPUT on stdin, so stdin is not available to carry the program. They are
# single-quoted heredocs: no shell expansion happens inside them, ever. Data
# always arrives as argv or on stdin — never spliced into the program text.
# [audit A25 — the class of bug, not just the one instance of it]
read -r -d '' PY_TXT_PORT <<'PY' || true
import re, sys
key = sys.argv[1]
raw = sys.stdin.read()
# One TXT resource record per line. Within a line a record may be split into
# adjacent quoted 255-byte character-strings, which DNS defines as concatenated,
# so join those; but keep separate RRs separate, because two RRs naming two
# different ports is an ambiguity, not a longer string.
found = set()
for line in raw.splitlines():
    parts = re.findall(r'"([^"]*)"', line)
    record = "".join(parts) if parts else line.strip()
    if not record:
        continue
    for m in re.finditer(r'(?:^|[;,\s])%s\s*=\s*(\d{1,5})(?=$|[;,\s])' % re.escape(key), record):
        n = int(m.group(1))
        if 1 <= n <= 65535:
            found.add(n)
# Exactly one answer, or nothing. Two different ports is ambiguous, and guessing
# which one the operator meant is precisely the kind of fail-open this launcher
# exists to avoid.
print(found.pop() if len(found) == 1 else "")
PY

read -r -d '' PY_CERT_ID <<'PY' || true
import os, re, sys
host = sys.argv[1].lower()
txt = sys.stdin.read()

def field(prefix, key):
    for line in txt.splitlines():
        if line.startswith(prefix):
            m = re.search(r'(?:^|,)\s*%s=((?:[^,\\]|\\.)*)' % key, line[len(prefix):])
            if m:
                return m.group(1).replace("\\", "")
    return ""

issuer_o = field("issuer=", "O")
issuer_cn = field("issuer=", "CN")
names = set(n.lower().rstrip(".") for n in re.findall(r'DNS:([^,\s]+)', txt))
cn = field("subject=", "CN")
if cn:
    names.add(cn.lower().rstrip("."))

def matches(n):
    if n == host:
        return True
    if n.startswith("*."):                    # exactly one label, per RFC 6125
        return host.endswith(n[1:]) and host.count(".") == n.count(".")
    return False

want_o = os.environ.get("ISSUER_ORG", "")
want_cn = os.environ.get("ISSUER_CN_RE", "")
problems = []
if want_o and issuer_o != want_o:
    problems.append("issuer O=%r, expected %r" % (issuer_o, want_o))
if want_cn:
    try:
        ok = bool(re.search(want_cn, issuer_cn or ""))
    except re.error:
        ok = False
        problems.append("policy expected_issuer_cn_regex is not a valid regex")
    if not ok:
        problems.append("issuer CN=%r does not match %r" % (issuer_cn, want_cn))
if not any(matches(n) for n in names):
    problems.append("leaf identifies %s, not %s" % (sorted(names) or ["nothing"], host))
ctrl = re.compile(r"[\x00-\x1f\x7f-\x9f]")
if problems:
    print("FAIL " + ctrl.sub("", "; ".join(problems))[:240])
else:
    print("OK " + ctrl.sub("", "issuer %s / %s, leaf matches %s" % (issuer_o, issuer_cn, host))[:240])
PY

read -r -d '' PY_MODEL_INFO <<'PY' || true
